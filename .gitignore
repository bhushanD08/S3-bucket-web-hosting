
# Terraform working directories and provider cache
.terraform/
**/.terraform/
.terraform.lock.hcl
**/.terraform.lock.hcl

# Terraform state, plan, and crash files
*.tfstate
*.tfstate.*
**/errored.tfstate
*.tfplan
tfplan
crash.log
crash.*.log

# Local environment and secrets
.env
.env.*
.aws/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.pub

# Sensitive variable files
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform override and CLI config
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
